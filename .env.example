# ==========================================
# NMIT HACK LEAGUE - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# PostgreSQL Database Connection String
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/nmit_hack_league?schema=public
# For Supabase/Neon/Cloud: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nmit_hack_league?schema=public

# College Email Domain Constraint (Strictly enforced on backend)
COLLEGE_EMAIL_DOMAIN=nmit.ac.in

# JWT Authentication Secret
JWT_SECRET=super_secret_nmit_hack_league_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (Auto-created if not existing on boot)
ADMIN_NAME="NMIT Hack League Admin"
ADMIN_EMAIL=admin@nmit.ac.in
ADMIN_PASSWORD=AdminHackLeague@2026

# Client / Frontend URL (CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development
