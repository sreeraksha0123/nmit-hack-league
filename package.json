{
  "name": "nmit-hack-league",
  "version": "1.0.0",
  "description": "Official Hackathon Management & Participation Platform for NMIT Bengaluru",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run prisma:seed",
    "db:push": "npm --prefix backend run prisma:push",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
